-- 创建射线检测参数（用来判断你和目标之间有没有墙）
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude  -- 排除某些物体不检测
rayParams.IgnoreWater = true                           -- 忽略水

-- 队伍识别函数：判断某个玩家是不是你的队友
local function isSameTeam(plr)
    if not Config.TeamCheck then return false end      -- 没开队伍识别就直接返回"不是队友"
    if plr.Team == nil or LP.Team == nil then return false end  -- 没队伍也返回 false
    return plr.Team == LP.Team                          -- 队友就返回 true
end

-- 掩体识别函数：判断你和目标之间有没有墙挡着
-- partName 是要检测目标的哪个部位
local function hasLineOfSight(plr, partName)
    if not Config.WallCheck then return true end       -- 没开掩体识别就直接返回"能看见"
    if not LP.Character then return false end          -- 你自己没角色也返回看不见

    -- 找到目标身上的指定部位
    local tPart = plr.Character and plr.Character:FindFirstChild(partName)
    if not tPart then return false end

    -- 排除列表：你自己的角色、目标的角色、队伍指示器
    local filter = {LP.Character, plr.Character}
    local ti = workspace:FindFirstChild("TeamIndicators")
    if ti then table.insert(filter, ti) end
    rayParams.FilterDescendantsInstances = filter

    -- 从摄像机位置向目标发射一条射线
    local origin = Camera.CFrame.Position
    local dir = tPart.Position - origin
    local result = workspace:Raycast(origin, dir, rayParams)

    -- 如果射线什么都没打到 = 中间没墙 = 能看见
    return result == nil
end
-- 找出屏幕正中心最近的敌人
local function findTarget()
    local closest = nil                        -- 最终返回的目标
    local shortest = Config.FOVRadius          -- 最短距离（先设为 FOV 半径）
    local center = Camera.ViewportSize / 2     -- 屏幕正中心

    -- 遍历所有玩家
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end               -- 跳过自己
        if isSameTeam(plr) then continue end         -- 跳过队友
        if not plr.Character then continue end       -- 跳过没角色的

        -- 检查目标是否活着
        local hum = plr.Character:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end

        -- 找到要瞄准的部位（找不到就用身体中心代替）
        local part = plr.Character:FindFirstChild(Config.AimPart)
            or plr.Character:FindFirstChild("HumanoidRootPart")
        if not part then continue end

        -- 把目标的 3D 坐标转换成屏幕上的 2D 坐标
        local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
        if not onScreen then continue end            -- 不在屏幕上就跳过

        -- 算一下目标离屏幕中心有多远
        local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
        if d > Config.FOVRadius then continue end    -- 超出 FOV 圈就跳过

        -- 检查距离是否超过自瞄距离上限
        local myHrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        local tHrp = plr.Character:FindFirstChild("HumanoidRootPart")
        if myHrp and tHrp then
            if (myHrp.Position - tHrp.Position).Magnitude > Config.Distance then
                continue
            end
        end

        -- 检查中间有没有墙挡着
        if not hasLineOfSight(plr, Config.AimPart) then continue end

        -- 记录最近的
        if d < shortest then
            shortest = d
            closest = part
        end
    end
    return closest
end
-- 每一帧都运行
RunService.RenderStepped:Connect(function()
    if not Config.AimbotEnabled then return end       -- 没开自瞄就退出
    local target = findTarget()                        -- 找目标
    if not target then return end                      -- 没目标就退出

    local camPos = Camera.CFrame.Position              -- 摄像机当前位置
    local desired = CFrame.new(camPos, target.Position)  -- 想要看向的位置

    -- alpha 是插值系数，越大转得越快
    local alpha = math.clamp(Config.AimSmoothness * Config.AimSpeed, 0.01, 1)

    -- Lerp 是"线性插值"，让摄像机平滑过渡到目标方向
    -- 就像缓慢转动脑袋看向目标，而不是瞬间甩过去
    Camera.CFrame = Camera.CFrame:Lerp(desired, alpha)
end)
local espCache = {}   -- 缓存每个玩家的透视对象，避免重复创建

-- 给某个玩家创建/更新透视
local function ensureESP(plr)
    if plr == LP then return end                 -- 跳过自己
    if not plr.Character then return end         -- 没角色跳过

    local data = espCache[plr]

    -- 如果这个玩家还没有透视对象，就创建一套
    if not data then
        -- Highlight：让整个人物发光（穿透显示）
        local hl = Instance.new("Highlight")
        hl.Name = "PiESP_HL"
        hl.FillTransparency = 0.5                -- 内部半透明
        hl.OutlineTransparency = 0               -- 边框不透明
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop  -- 永远显示在最前面
        hl.Parent = game:GetService("CoreGui")

        -- BillboardGui：在头顶上方显示文字
        local bb = Instance.new("BillboardGui")
        bb.Name = "PiESP_BB"
        bb.Size = UDim2.new(0, 200, 0, 60)        -- 200x60 像素
        bb.StudsOffset = Vector3.new(0, 3, 0)     -- 头顶上方 3 格
        bb.AlwaysOnTop = true
        bb.Parent = game:GetService("CoreGui")

        -- 名字文字
        local n = Instance.new("TextLabel", bb)
        n.Name = "NameLbl"
        n.Size = UDim2.new(1, 0, 0.4, 0)          -- 占顶部 40%
        n.BackgroundTransparency = 1               -- 背景透明
        n.TextColor3 = Color3.new(1, 1, 1)
        n.TextStrokeTransparency = 0.5             -- 描边半透明
        n.TextScaled = true                        -- 自动缩放
        n.Font = Enum.Font.GothamSemibold

        -- 血量文字
        local h = Instance.new("TextLabel", bb)
        h.Name = "HealthLbl"
        h.Position = UDim2.new(0, 0, 0.4, 0)       -- 从 40% 处开始
        h.Size = UDim2.new(1, 0, 0.3, 0)
        h.BackgroundTransparency = 1
        h.TextColor3 = Color3.new(0, 1, 0)
        h.TextStrokeTransparency = 0.5
        h.TextScaled = true
        h.Font = Enum.Font.GothamSemibold

        -- 距离文字
        local dL = Instance.new("TextLabel", bb)
        dL.Name = "DistLbl"
        dL.Position = UDim2.new(0, 0, 0.7, 0)      -- 从 70% 处开始
        dL.Size = UDim2.new(1, 0, 0.3, 0)
        dL.BackgroundTransparency = 1
        dL.TextColor3 = Color3.new(1, 1, 0)
        dL.TextStrokeTransparency = 0.5
        dL.TextScaled = true
        dL.Font = Enum.Font.GothamSemibold

        -- 把创建的对象存起来
        data = {HL = hl, BB = bb, N = n, H = h, D = dL}
        espCache[plr] = data
    end

    -- 如果透视总开关关了，或者目标没角色了，就隐藏
    if not Config.ESPEnabled or not plr.Character then
        data.HL.Enabled = false
        data.BB.Enabled = false
        return
    end

    -- 判断是队友还是敌人，决定颜色
    local isMate = Config.ESPTeamCheck and plr.Team == LP.Team
    local color = isMate and Color3.fromRGB(0, 255, 0)    -- 队友绿色
                       or Color3.fromRGB(255, 0, 0)       -- 敌人红色

    -- 更新发光
    data.HL.Adornee = plr.Character
    data.HL.FillColor = color
    data.HL.OutlineColor = color
    data.HL.Enabled = true

    -- 把文字框挂在头顶
    local head = plr.Character:FindFirstChild("Head")
    if head then data.BB.Adornee = head end
    data.BB.Enabled = Config.ESPShowName or Config.ESPShowHealth or Config.ESPShowDistance

    -- 名字
    data.N.Visible = Config.ESPShowName
    data.N.Text = plr.Name .. (isMate and " [队友]" or " [敌人]")
    data.N.TextColor3 = color

    -- 血量
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    data.H.Visible = Config.ESPShowHealth
    if hum then
        data.H.Text = string.format("%d / %d", math.floor(hum.Health), math.floor(hum.MaxHealth))
    end

    -- 距离
    data.D.Visible = Config.ESPShowDistance
    local myHrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local tHrp = plr.Character:FindFirstChild("HumanoidRootPart")
    if myHrp and tHrp then
        data.D.Text = string.format("%d m", math.floor((myHrp.Position - tHrp.Position).Magnitude))
    end
end

